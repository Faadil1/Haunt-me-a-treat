<Rive version="1" kind="fragment">
    <!-- Candy HUD: bag icon + big number bound to Costume.candies, with a
         bounce + glow state machine that plays whenever candies changes. -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" width="320" height="140" styleId="0:5" name="CandyHud" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <Node x="160" y="70" name="HudGroup" id="0:10">
            <Shape name="Glow" id="0:30">
                <Ellipse width="130" height="120" originX="0.5" originY="0.5" name="Path" id="0:31"/>
                <Fill name="Fill" id="0:32">
                    <SolidColor colorValue="FFFFD38A" name="Color" id="0:33"/>
                </Fill>
            </Shape>

            <Shape x="-95" y="0" name="CandyIcon" id="0:20">
                <Rectangle width="72" height="58" cornerRadiusTL="16" originX="0.5" originY="0.5" name="Path" id="0:21"/>
                <Fill name="Fill" id="0:22">
                    <SolidColor colorValue="FFD98A3D" name="Color" id="0:23"/>
                </Fill>
            </Shape>

            <Text x="-40" y="0" originX="0" originY="0.5" sizingValue="autoWidth" name="CandyCount" id="0:12">
                <TextStylePaint fontSize="52" fontAssetId="0:90" name="Style" id="0:13">
                    <Fill name="Fill" id="0:16"><SolidColor colorValue="FFFFF4E3" name="Color" id="0:17"/></Fill>
                </TextStylePaint>
                <TextValueRun styleId="0:13" text="0" name="Run" id="0:14">
                    <DataBindContext sourcePathIds="0:40-0:41" propertyKey="268" converterId="0:62" id="0:94"/>
                </TextValueRun>
            </Text>
        </Node>

        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="640" y="-120" id="0:91"/>
                <ExitState x="840" y="-120" id="0:92"/>
                <EntryState x="0" y="-120" id="0:93">
                    <StateTransition stateToId="0:60" id="0:95"/>
                </EntryState>

                <AnimationState x="200" y="0" animationId="0:70" stateName="Idle" id="0:60">
                    <StateTransition stateToId="0:61" id="0:96">
                        <TransitionViewModelCondition id="0:97">
                            <TransitionPropertyViewModelComparator id="0:98">
                                <BindablePropertyTrigger id="0:99">
                                    <DataBindContext sourcePathIds="0:40-0:42" propertyKey="686" id="0:100"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator id="0:101"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="400" y="0" animationId="0:71" stateName="Bump" id="0:61">
                    <StateTransition stateToId="0:60" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" id="0:102"/>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <LinearAnimation duration="1" fps="60" name="Idle" id="0:70">
            <KeyedObject objectId="0:10" id="0:103">
                <KeyedProperty propertyKey="16" id="0:104">
                    <KeyFrameDouble value="1" interpolationType="linear" frame="0" id="0:105"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17" id="0:106">
                    <KeyFrameDouble value="1" interpolationType="linear" frame="0" id="0:107"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:30" id="0:108">
                <KeyedProperty propertyKey="18" id="0:109">
                    <KeyFrameDouble value="0" interpolationType="linear" frame="0" id="0:110"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="20" fps="60" name="Bump" id="0:71">
            <KeyedObject objectId="0:10" id="0:111">
                <KeyedProperty propertyKey="16" id="0:112">
                    <KeyFrameDouble value="1" interpolationType="linear" frame="0" id="0:113"/>
                    <KeyFrameDouble value="1.3" interpolationType="linear" frame="8" id="0:114"/>
                    <KeyFrameDouble value="1" interpolationType="linear" frame="20" id="0:115"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17" id="0:116">
                    <KeyFrameDouble value="1" interpolationType="linear" frame="0" id="0:117"/>
                    <KeyFrameDouble value="1.3" interpolationType="linear" frame="8" id="0:118"/>
                    <KeyFrameDouble value="1" interpolationType="linear" frame="20" id="0:119"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:30" id="0:120">
                <KeyedProperty propertyKey="18" id="0:121">
                    <KeyFrameDouble value="0" interpolationType="linear" frame="0" id="0:122"/>
                    <KeyFrameDouble value="1" interpolationType="linear" frame="6" id="0:123"/>
                    <KeyFrameDouble value="0" interpolationType="linear" frame="20" id="0:124"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <ScriptedDrawable scriptAssetId="0:81" name="CandyWatcher" id="0:35"/>
